# Copy to .env.local and fill in. Never commit the filled copy: .gitignore already excludes it.
#
# The Cloudflare token for a NAMED tunnel, from the dashboard under
# Zero Trust > Networks > Tunnels > (your tunnel) > Configure. Each machine needs its own tunnel:
# two connectors sharing one token both serve that hostname, and Cloudflare load-balances between
# them, so requests would alternate between machines with different data. Leave empty to run only
# on localhost -- the cloudflared service is behind the `public` profile and is not started by
# `docker compose up` without it.
TUNNEL_TOKEN=

# Transactional mail, used to tell a submitter their design finished. Left empty the job still
# runs and the log notes it could not send.
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=TAUSO

# The address results are reachable at. It is baked into the links in those mails, so it has to be
# what this machine actually answers on: http://localhost:8501 for a local install, or the tunnel
# hostname. A stale value here mails out links that resolve to nothing.
PUBLIC_BASE_URL=http://localhost:8501

# Where the contact form sends to.
CONTACT_EMAIL=
